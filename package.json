{
  "name": "ayonto-mention",
  "version": "1.1.0",
  "private": true,
  "description": "@mention component and notification framework for Microsoft Power Apps and Dataverse.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayonto-Digital-Solutions/ayonto-mention.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm --prefix pcf run build",
    "rebuild": "npm --prefix pcf run rebuild",
    "clean": "npm --prefix pcf run clean",
