<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <!-- The component is Ayonto.AyontoMentionControl, not Ayonto.MentionControl.

       The productive legacy control already occupies Ayonto.MentionControl in
       the environments this one has to live in, and the two are not versions of
       each other: this component requires recordId, recordTable and
       mentionMetadata, which the legacy contract does not have. An imported code
       component may gain optional properties in a later version but not required
       ones — the documented remedy is a component with a new name, reconfigured
       where it is used. So this keeps the Ayonto namespace and takes a name of
       its own, and the two can sit on the same form.
       https://learn.microsoft.com/power-apps/developer/component-framework/faq -->
  <control namespace="Ayonto" constructor="AyontoMentionControl" version="1.0.1" display-name-key="MentionControl_Display_Key" description-key="MentionControl_Desc_Key" control-type="virtual" >
    <!-- This control calls no third-party service. Mentions are looked up through
         the Dataverse Web API of the environment the control already runs in. -->
    <external-service-usage enabled="false">
    </external-service-usage>

    <!-- The bound column the editor reads and writes. The type group covers the
         ordinary Dataverse text columns a comment or note field uses. -->
    <type-group name="text">
      <type>Multiple</type>
      <type>SingleLine.Text</type>
      <type>SingleLine.TextArea</type>
    </type-group>
    <property name="field" display-name-key="Field_Display_Key" description-key="Field_Desc_Key" of-type-group="text" usage="bound" required="true" />

    <!-- The framework exposes no supported, generic way for a control to learn
         which record it is placed on, and discovering it through Xrm, the form
         context or contextInfo is not supported code. The maker therefore binds
         the record id and table explicitly, so persistence can stay on documented
         APIs. The column name is NOT asked for: it is read from the bound field's
         own metadata (attributes.LogicalName). -->
    <property name="recordId" display-name-key="RecordId_Display_Key" description-key="RecordId_Desc_Key" of-type="SingleLine.Text" usage="input" required="true" />
    <property name="recordTable" display-name-key="RecordTable_Display_Key" description-key="RecordTable_Desc_Key" of-type="SingleLine.Text" usage="input" required="true" />

    <!-- The companion column that carries the mentions of the current editing
         session out with the record. It is written together with the text, in the
         same save, and a server-side step turns it into notifications once the
         record is actually committed. One companion column per mention-enabled
         text column: two editors on one form would otherwise overwrite each
         other's value, because a column has exactly one value and each control
         writes its own. Configure it hidden; it is not for people to read. -->
    <property name="mentionMetadata" display-name-key="MentionMetadata_Display_Key" description-key="MentionMetadata_Desc_Key" of-type="Multiple" usage="bound" required="true" />

    <!-- How tall the editor is at its smallest, in rows of text.

         The height a maker sets in the form designer lives in the cell's rowspan,
         and no code component API reads it: in a model-driven app `updateView`
         reports `allocatedHeight` as -1 whether or not `trackContainerResize` is
         switched on. Measuring the host's own box would mean reaching outside the
         component, which is not supported. So the maker says it instead, and this
         value is what the field falls back to.

         Optional, with a default, and that is not a matter of taste: a newer
         version of an imported code component may add optional properties but may
         not add required ones. Forms configured before this property existed keep
         working untouched. A value below 1 or above 30 is taken as the nearest of
         the two; a value that cannot be read as a number at all, or none, is 3. -->
    <property name="minRows" display-name-key="MinRows_Display_Key" description-key="MinRows_Desc_Key" of-type="Whole.None" usage="input" required="false" default-value="3" />

    <resources>
      <code path="index.ts" order="1"/>
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
      <resx path="strings/MentionControl.1033.resx" version="1.0.0" />
      <resx path="strings/MentionControl.1031.resx" version="1.0.0" />
    </resources>

    <!-- The user lookup reads the systemuser table through the supported
         context.webAPI surface. No other framework feature is used. -->
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
